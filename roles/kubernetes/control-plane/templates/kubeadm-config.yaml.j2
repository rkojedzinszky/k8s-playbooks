---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
apiServer:
  certSANs: {{ kubernetes_apiserver_certsans | to_json }}
  extraArgs:
  - name: client-ca-file
    value: /etc/kubernetes/pki/ca-bundle.crt
  - name: requestheader-client-ca-file
    value: /etc/kubernetes/pki/front-proxy-ca-bundle.crt
controllerManager:
  extraArgs:
  - name: root-ca-file
    value: /etc/kubernetes/pki/ca-bundle.crt
  - name: client-ca-file
    value: /etc/kubernetes/pki/ca-bundle.crt
  - name: requestheader-client-ca-file
    value: /etc/kubernetes/pki/front-proxy-ca-bundle.crt
kubernetesVersion: v{{ kubernetes_version }}
networking:
  serviceSubnet: {{ kubernetes_service_subnet }}
  podSubnet: {{ kubernetes_pod_subnet }}
{% if kubernetes_master_lb_address is defined %}
controlPlaneEndpoint: {{ kubernetes_master_lb_address }}
{% endif %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
{% if kubernetes_node_ips %}
localAPIEndpoint:
  advertiseAddress: {{ kubernetes_node_ips | join(",") }}
{% endif %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
authentication:
  x509:
    clientCAFile: /etc/kubernetes/pki/ca-bundle.crt
